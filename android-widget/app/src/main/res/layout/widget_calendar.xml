            android:gravity="center" android:textSize="9sp" android:textColor="@color/text_muted" android:text="จ" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="9sp" android:textColor="@color/text_muted" android:text="อ" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="9sp" android:textColor="@color/text_muted" android:text="พ" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="9sp" android:textColor="@color/text_muted" android:text="พฤ" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:textSize="9sp" android:textColor="@color/text_muted" android:text="ศ" />
