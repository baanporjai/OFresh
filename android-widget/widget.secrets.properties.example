# คัดลอกไฟล์นี้เป็น widget.secrets.properties (ไฟล์นั้นถูก .gitignore ไว้แล้ว ห้าม commit ค่าจริง)
#
# WORKER_BASE_URL = โดเมนของ Cloudflare Worker ตัวเดียวกับที่ deploy order-api-worker.js
#                    (ไม่มี / ปิดท้าย)
# WIDGET_TOKEN     = ค่าเดียวกับ secret ที่ตั้งไว้บน Worker ด้วย `wrangler secret put WIDGET_TOKEN`
#                    (สุ่มค่ายาวๆ เอง เช่น `openssl rand -hex 32`)

WORKER_BASE_URL=https://your-worker.example.workers.dev
WIDGET_TOKEN=paste-the-same-value-you-put-in-wrangler-secret-here
