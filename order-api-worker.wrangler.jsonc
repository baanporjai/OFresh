{
  // Separate config from the sibling wrangler.jsonc — that one deploys the static
  // marketing site ("ofresh" Worker, assets-only). This one is specifically for
  // order-api-worker.js, deployed as the "fancy-dust-060c" Worker.
  //
  // The kv_namespaces binding here MUST stay in sync with what's actually bound —
  // wrangler deploy replaces the full binding set from this config on every deploy.
  // Secrets (LINE_CHANNEL_TOKEN, GEMINI_API_KEY, etc. — see the doc comment at the
  // top of order-api-worker.js) are NOT declared here; they're set via
  // `wrangler secret put <NAME> --name fancy-dust-060c` and persist independently
  // of code/config deploys.
  "name": "fancy-dust-060c",
  "main": "order-api-worker.js",
  "compatibility_date": "2026-07-08",
  // ต้องเปิดไว้เสมอ — order.html/dashboard/LINE webhook ทุกอย่างชี้มาที่โดเมนนี้ตรงๆ อยู่แล้ว
  // (ไม่ได้ตั้งใจย้ายไป custom domain ทั้งหมด แค่เพิ่ม route เฉพาะ /realstat/* เข้ามาเสริม) —
  // ลืมใส่บรรทัดนี้ตอน deploy ครั้งก่อนหน้าทำให้ wrangler ปิด workers.dev ให้อัตโนมัติ เว็บ/บอทล่มไปพักหนึ่ง
  "workers_dev": true,
  "kv_namespaces": [
    { "binding": "OFRESH_KV", "id": "6cfd5b8831a146aba54365bf20b948a3" }
  ],
  // Path-specific Route on the same zone as the static "ofresh" Worker — confirmed
  // ofresh.baanporjai.com is bound via Route (not an exclusive Custom Domain), so this
  // more-specific /realstat/* pattern takes over just that path; the static Worker
  // keeps serving everything else on the domain untouched.
  "routes": [
    { "pattern": "ofresh.baanporjai.com/realstat/*", "zone_name": "baanporjai.com" }
  ]
}
